# Required for real AI generation
GEMINI_API_KEY=your_gemini_api_key_here

# Current model can be changed without editing code.
# The project documentation originally specified gemini-1.5-pro.
# Use a currently available Gemini model for new projects.
GEMINI_MODEL=gemini-3.7-flash

# Local API URL used by Streamlit
BACKEND_URL=http://127.0.0.1:8000
